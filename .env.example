# Provider priority: GEMINI_API_KEY, then XAI_API_KEY, then OPENAI_API_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
XAI_API_KEY=
XAI_MODEL=grok-4
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AMAZON_ASSOCIATE_TAG=dailyvirald06-20

# Pinterest API (internal pin publisher — never commit real secrets)
# Register at https://developers.pinterest.com/ — scopes: boards:read, boards:write, pins:read, pins:write
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Must match the Redirect URI registered on the Pinterest app exactly.
PINTEREST_REDIRECT_URI=https://mybusinesswork.com/oauth/pinterest/
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
# Board id for Amazon Great Finds (from board URL / API)
PINTEREST_BOARD_ID=
# Trial apps cannot create Pins on production until Standard access is approved.
# Set to 1 only for sandbox testing (needs a sandbox board id; Pins stay private to you).
PINTEREST_USE_SANDBOX=0
# Optional full override, e.g. https://api-sandbox.pinterest.com/v5
# PINTEREST_API_BASE=
# Optional override; defaults to astro site https://mybusinesswork.com
SITE_URL=https://mybusinesswork.com
