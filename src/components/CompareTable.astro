---
import { withPostTag } from '../lib/affiliate';

interface Row {
    role: 'this' | 'cheaper' | 'different';
    name: string;
    bestFor: string;
    limit: string;
    href: string;
}

interface Props {
    rows: Row[];
    affiliateUrl: string;
}

const { rows, affiliateUrl } = Astro.props;
const roleLabel = {
    this: 'This pick',
    cheaper: 'Cheaper option',
    different: 'Different style',
} as const;

const ordered = (['this', 'cheaper', 'different'] as const)
    .map((role) => rows.find((row) => row.role === role))
    .filter((row): row is Row => Boolean(row));
---

<section class="compare-block" aria-labelledby="compare-title">
    <h2 id="compare-title">How it compares</h2>
    <p class="compare-lead">We don't list prices. They change. Open Amazon to see today's price.</p>
    <table class="compare-table">
        <thead>
            <tr>
                <th scope="col">Pick</th>
                <th scope="col">Good when</th>
                <th scope="col">The catch</th>
            </tr>
        </thead>
        <tbody>
            {ordered.map((row) => {
                const href = row.role === 'this' ? affiliateUrl : withPostTag(row.href, affiliateUrl);
                return (
                    <tr>
                        <th scope="row">
                            <span class="compare-role">{roleLabel[row.role]}</span>
                            <a href={href} rel="nofollow sponsored noopener" target="_blank">{row.name}</a>
                        </th>
                        <td data-label="Good when">{row.bestFor}</td>
                        <td data-label="The catch">{row.limit}</td>
                    </tr>
                );
            })}
        </tbody>
    </table>
</section>

<style>
    .compare-block { margin: 8px 0 28px; }
    .compare-block h2 {
        font-family: var(--display);
        font-size: 1.3rem;
        margin: 0 0 6px;
    }
    .compare-lead {
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 0.95rem;
    }
    .compare-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
    }
    .compare-table th,
    .compare-table td {
        text-align: left;
        vertical-align: top;
        padding: 12px 14px;
        border-bottom: 1px solid var(--line);
        font-size: 0.95rem;
        line-height: 1.4;
    }
    .compare-table tr:last-child th,
    .compare-table tr:last-child td { border-bottom: 0; }
    .compare-table thead th {
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
        background: #f8eef1;
    }
    .compare-role {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--accent-ink);
        margin-bottom: 2px;
    }
    .compare-table a { font-weight: 650; }

    @media (max-width: 779px) {
        .compare-table thead { display: none; }
        .compare-table,
        .compare-table tbody,
        .compare-table tr,
        .compare-table th,
        .compare-table td { display: block; width: 100%; }
        .compare-table { background: transparent; border: 0; }
        .compare-table tr {
            border: 1px solid var(--line);
            border-radius: 12px;
            background: var(--surface);
            margin: 0 0 10px;
            overflow: hidden;
        }
        .compare-table th,
        .compare-table td { border-bottom: 1px solid var(--line); }
        .compare-table td::before {
            content: attr(data-label);
            display: block;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 2px;
        }
    }
</style>
