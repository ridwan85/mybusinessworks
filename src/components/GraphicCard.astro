---
interface Props {
  title: string;
  eyebrow?: string;
  lines?: string[];
  compact?: boolean;
}
const { title, eyebrow, lines = [], compact = false } = Astro.props;
const shown = lines.map((line) => line.trim()).filter(Boolean).slice(0, compact ? 0 : 3);
---

<div class:list={['graphic-card', compact && 'is-compact']} aria-hidden="true">
  <p class="brand">mybusinesswork.com</p>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <p class="headline">{title}</p>
  {shown.length > 0 && (
    <ul>
      {shown.map((line) => <li>{line}</li>)}
    </ul>
  )}
</div>

<style>
  .graphic-card {
    width: 100%;
    height: 100%;
    min-height: 240px;
    aspect-ratio: 1;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    padding: 22px 20px 24px;
    border-radius: 14px;
    border: 1px solid var(--line, #e0d6db);
    background:
      linear-gradient(180deg, rgba(181, 107, 120, 0.22), transparent 42%),
      var(--surface, #fcfafb);
    color: var(--fg, #1c171a);
  }
  .brand {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent, #b56b78);
  }
  .eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted, #6d6168);
  }
  .headline {
    margin: 0;
    font-family: var(--display, Georgia, 'Times New Roman', serif);
    font-size: clamp(1.15rem, 2.5vw, 1.55rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  ul {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }
  li {
    position: relative;
    padding-left: 16px;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--muted, #6d6168);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent, #b56b78);
  }
  .is-compact {
    min-height: 0;
    justify-content: flex-end;
    gap: 8px;
    padding: 16px;
  }
  .is-compact .headline {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    -webkit-line-clamp: 6;
  }
</style>
