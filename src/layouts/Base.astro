---
interface Props {
  title: string;
  description: string;
  image?: string;
  layout?: 'default' | 'landing' | 'review';
  noindex?: boolean;
  /** Open Graph type — website (default), article for reviews */
  ogType?: 'website' | 'article';
}
const { title, description, image, layout = 'default', noindex = false, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const isLanding = layout === 'landing';
const isWide = layout === 'landing' || layout === 'review';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Daily Viral Deals" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --fg: #1c171a;
        --muted: #6d6168;
        --accent: #b56b78;
        --accent-ink: #1f1418;
        --amazon: #ff9900;
        --amazon-ink: #111111;
        --bg: #f5f1f3;
        --bg-deep: #ebe4e8;
        --surface: #fcfafb;
        --line: #e0d6db;
        --brand: #1a1417;
        --wrap: 860px;
        --wrap-wide: 1120px;
        /* Text inset; cards/carousels may bleed past this */
        --page-gutter: 24px;
        --font: 'IBM Plex Sans', 'Helvetica Neue', Helvetica, sans-serif;
        --display: 'IBM Plex Serif', Georgia, 'Times New Roman', serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font: 17px/1.7 var(--font);
        color: var(--fg);
        background:
          radial-gradient(1100px 480px at 8% -8%, rgba(181, 107, 120, 0.14), transparent 55%),
          radial-gradient(900px 420px at 100% 0%, rgba(140, 120, 130, 0.12), transparent 52%),
          linear-gradient(180deg, var(--bg) 0%, #f8f5f6 48%, var(--bg-deep) 100%);
        min-height: 100vh;
      }
      a { color: #8a4f5c; }
      .wrap,
      .wrap-wide {
        max-width: var(--wrap-wide);
        margin: 0 auto;
        padding-left: var(--page-gutter);
        padding-right: var(--page-gutter);
        box-sizing: border-box;
      }
      .wrap { max-width: var(--wrap); }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(10px);
        background: rgba(245, 241, 243, 0.88);
        border-bottom: 1px solid rgba(224, 214, 219, 0.9);
      }
      .site-header .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 0;
        min-height: 52px;
      }
      .site-header a.brand {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(1.05rem, 2vw, 1.2rem);
        color: var(--brand);
        text-decoration: none;
        letter-spacing: -0.02em;
        white-space: nowrap;
        flex: 0 1 auto;
      }
      .site-header nav {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 14px;
        flex: 0 0 auto;
      }
      .site-header nav a {
        color: var(--muted);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
      }
      .site-header nav a:hover { color: var(--fg); }

      .site-footer {
        border-top: 1px solid var(--line);
        margin-top: 72px;
        padding: 28px 0 40px;
        color: var(--muted);
        font-size: 14px;
        background: rgba(255, 255, 255, 0.35);
      }
      .site-footer p { margin: 0 0 8px; }
      .site-footer a { color: var(--muted); }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
        padding: 0;
        list-style: none;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        height: 100%;
        transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
      }
      .card:hover {
        transform: translateY(-3px);
        border-color: #d2c4ca;
        box-shadow: 0 12px 28px rgba(40, 24, 30, 0.08);
      }
      .card img { width: 100%; aspect-ratio: 1; object-fit: cover; background: #fff; display: block; }
      .card h2, .card h3 { font-size: 1.05rem; line-height: 1.35; margin: 0 0 6px; letter-spacing: -0.01em; }

      .hero { text-align: center; margin: 0 auto 20px; }
      .hero img { width: 100%; max-width: 640px; height: auto; border-radius: 12px; }
      .hero figcaption,
      .gallery figcaption {
        margin: 10px auto 0;
        max-width: 36rem;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.45;
      }
      .gallery { margin: 28px 0 36px; }
      .gallery h2 { font-size: 1.35rem; margin: 0 0 12px; font-family: var(--display); }
      .gallery ul {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 18px 12px;
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .gallery figure { margin: 0; }
      .gallery img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: #fff;
      }
      .gallery figcaption {
        margin-top: 8px;
        text-align: left;
        font-size: 0.88rem;
      }
      .cta {
        display: inline-block;
        background: var(--accent);
        color: var(--accent-ink);
        font-weight: 700;
        padding: 13px 22px;
        border-radius: 10px;
        text-decoration: none;
        transition: transform 180ms ease, filter 180ms ease;
      }
      .cta:hover { transform: translateY(-1px); filter: brightness(1.03); }
      .cta-amazon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--amazon);
        color: var(--amazon-ink);
        font-weight: 700;
        padding: 13px 22px;
        border-radius: 10px;
        text-decoration: none;
        transition: transform 180ms ease, filter 180ms ease;
        min-height: 48px;
        text-align: center;
      }
      .cta-amazon:hover { transform: translateY(-1px); filter: brightness(1.03); }
      .cta-ghost {
        display: inline-block;
        color: var(--fg);
        font-weight: 700;
        padding: 13px 18px;
        text-decoration: none;
        border-bottom: 2px solid var(--accent);
      }
      .notice {
        background: #f8eef1;
        border: 1px solid #e5cdd4;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 14px;
      }
      blockquote {
        margin: 20px 0;
        padding: 8px 16px;
        background: rgba(255, 255, 255, 0.7);
        border-left: 4px solid var(--accent);
      }
      /* Only vertical — never wipe .wrap / .wrap-wide side gutters */
      main.page {
        padding-top: 24px;
        padding-bottom: 20px;
      }
      /* Review pages own their H1 styling inside the article. */
      main.page > h1 {
        font-family: var(--display);
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0 0 14px;
      }

      @media (max-width: 720px) {
        body { font-size: 16px; }
        :root { --page-gutter: 20px; }
        .site-header .bar {
          gap: 10px;
          padding: 10px 0;
          align-items: center;
        }
        .site-header a.brand {
          font-size: 0.98rem;
          max-width: 46%;
          overflow: hidden;
          text-overflow: ellipsis;
        }
        .site-header nav {
          gap: 12px;
        }
        .site-header nav a {
          font-size: 0.78rem;
        }
        .site-header nav a[href='/disclosure/'] {
          display: none; /* keep header one clean row on phones */
        }
        main.page {
          padding-top: 16px;
          padding-bottom: 28px;
        }
        .grid {
          grid-template-columns: 1fr;
          gap: 14px;
        }
        .cta-amazon,
        .cta {
          width: 100%;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .card, .cta, .cta-amazon { transition: none; }
        .card:hover, .cta:hover, .cta-amazon:hover { transform: none; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class:list={[isWide ? 'wrap-wide' : 'wrap']}>
        <div class="bar">
          <a class="brand" href="/">Daily Viral Deals</a>
          <nav>
            <a href="/#categories">Categories</a>
            <a href="/#reviews">Reviews</a>
            <a href="/disclosure/">Disclosure</a>
          </nav>
        </div>
      </div>
    </header>
    <main class:list={[isLanding ? undefined : 'page', isLanding ? undefined : isWide ? 'wrap-wide' : 'wrap']}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class:list={[isWide ? 'wrap-wide' : 'wrap']}>
        <p>As an Amazon Associate I earn from qualifying purchases.</p>
        <p>&copy; {new Date().getFullYear()} Daily Viral Deals &middot; <a href="/disclosure/">Affiliate Disclosure</a> &middot; <a href="/privacy/">Privacy Policy</a></p>
      </div>
    </footer>
  </body>
</html>
