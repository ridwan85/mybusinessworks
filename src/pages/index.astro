---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { categoryHubs, reviewsForHub } from '../lib/categories';

const reviews = (await getCollection('reviews')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = reviews[0];

const heroSlides = [
  '/images/site/hero-home-lifestyle.jpg',
  '/images/site/hero-workspace.jpg',
  '/images/site/hero-parcels.jpg',
];
const heroImage = heroSlides[0];

const coverage = categoryHubs.map((hub) => ({
  ...hub,
  count: reviewsForHub(reviews, hub).length,
  href: `/categories/${hub.slug}/`,
}));

const siteUrl = Astro.site ? new URL('/', Astro.site).href : 'https://mybusinesswork.com/';
const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Daily Viral Deals',
      url: siteUrl,
      description:
        'Helpful Amazon product reviews across categories—clear verdicts, real tradeoffs, and affiliate links that help US shoppers buy with confidence.',
      publisher: {
        '@type': 'Organization',
        name: 'Daily Viral Deals',
        url: siteUrl,
      },
    },
    {
      '@type': 'Organization',
      name: 'Daily Viral Deals',
      url: siteUrl,
    },
  ],
};
---

<Base
  layout="landing"
  ogType="website"
  title="Daily Viral Deals | Honest Amazon Product Picks"
  description="Helpful Amazon product reviews across categories—clear verdicts, real tradeoffs, and affiliate links that help US shoppers buy with confidence."
  image={heroImage}
>
  <section class="hook" aria-label="Hero">
    <div class="hook-media" aria-hidden="true">
      {heroSlides.map((src, i) => (
        <img class:list={['slide', i === 0 && 'is-active']} src={src} alt="" width="1600" height="900" data-slide={i} />
      ))}
      <div class="hook-shade"></div>
    </div>
    <div class="hook-copy">
      <p class="brand-mark">Daily Viral Deals</p>
      <h1>Clear reviews. Confident purchases.</h1>
      <p class="lede">
        Independent Amazon guidance for home, tech, and everyday essentials—so you know what matters before you buy.
      </p>
      <div class="cta-row">
        <a class="cta cta-amazon" href="#reviews">Shop reviews</a>
        {featured && (
          <a class="cta-ghost" href={`/reviews/${featured.id}/`}>Latest pick</a>
        )}
      </div>
    </div>
  </section>

  <nav class="shop-strip" aria-label="Shop by category">
    <div class="shop-strip-inner wrap-wide">
      {coverage.map((item) => (
        <a href={item.href}>
          <span>{item.label}</span>
          <em>{item.count > 0 ? `${item.count}` : 'Soon'}</em>
        </a>
      ))}
    </div>
  </nav>

  <section class="meat wrap-wide" aria-labelledby="meat-title">
    <div class="meat-intro">
      <h2 id="meat-title">What you get in every review</h2>
      <p>Practical buying help—not hype. The same structure, every category.</p>
    </div>
    <ol class="meat-points">
      <li>
        <strong>Quick verdict first</strong>
        <span>Get the bottom line before you dig into the details.</span>
      </li>
      <li>
        <strong>Who it’s actually for</strong>
        <span>Match the product to your needs, budget, and use case.</span>
      </li>
      <li>
        <strong>Honest tradeoffs</strong>
        <span>Pros, caveats, and FAQs grounded in listed product facts—not invented lab tests.</span>
      </li>
    </ol>
  </section>

  <section class="reviews-block wrap-wide" id="reviews" aria-labelledby="reviews-title">
    <div class="reviews-head">
      <h2 id="reviews-title">Latest reviews</h2>
      <p class="notice affiliate-note">As an Amazon Associate I earn from qualifying purchases.</p>
    </div>

    {reviews.length === 0 ? (
      <p>No reviews yet. Check back soon.</p>
    ) : (
      <ul class="grid review-grid">
        {reviews.map((r) => <ReviewCard review={r} />)}
      </ul>
    )}
  </section>

  <section class="coverage wrap-wide" id="categories" aria-labelledby="coverage-title">
    <div class="coverage-intro">
      <h2 id="coverage-title">Shop by category</h2>
      <p>Click a category to see related product reviews. New picks land here as the catalog grows.</p>
    </div>
    <ul class="coverage-grid">
      {coverage.map((item) => (
        <li>
          <a class="coverage-card" href={item.href}>
            <img src={item.src} alt="" loading="lazy" width="720" height="480" />
            <div>
              <h3>{item.label}</h3>
              <p>{item.blurb}</p>
              <span class="coverage-meta">
                {item.count > 0
                  ? `${item.count} ${item.count === 1 ? 'review' : 'reviews'} →`
                  : 'Coming soon →'}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="close-cta wrap-wide" aria-labelledby="close-title">
    <div class="close-panel">
      <img class="close-bg" src="/images/site/hero-parcels.jpg" alt="" aria-hidden="true" />
      <div class="close-shade"></div>
      <div class="close-copy">
        <h2 id="close-title">Ready to choose with confidence?</h2>
        <p>Open a review, scan the verdict, then check today’s price on Amazon.</p>
        <div class="cta-row">
          {featured ? (
            <a class="cta" href={`/reviews/${featured.id}/`}>Open latest review</a>
          ) : (
            <a class="cta" href="#reviews">Browse reviews</a>
          )}
          <a class="cta-ghost" href="/disclosure/">How affiliate links work</a>
        </div>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />
</Base>

<script>
  const slides = [...document.querySelectorAll('.hook-media .slide')];
  if (slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    setInterval(() => {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    }, 5500);
  }
</script>

<style>
  .hook {
    position: relative;
    min-height: min(82vh, 720px);
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #f5f6f8;
    text-align: center;
  }
  .hook-media { position: absolute; inset: 0; }
  .hook-media .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 1.1s ease;
  }
  .hook-media .slide.is-active {
    opacity: 1;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .hook-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 48%, rgba(20, 12, 16, 0.55) 0%, rgba(20, 12, 16, 0.28) 52%, rgba(20, 12, 16, 0.62) 100%),
      linear-gradient(180deg, rgba(22, 14, 18, 0.45) 0%, rgba(22, 14, 18, 0.18) 38%, rgba(22, 14, 18, 0.72) 100%);
  }
  .hook-copy {
    position: relative;
    z-index: 1;
    width: min(720px, calc(100% - 40px));
    padding: 72px 0 80px;
    margin: 0 auto;
    animation: rise 700ms ease both;
  }
  .brand-mark {
    margin: 0 0 18px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.35rem, 7vw, 4.1rem);
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: #fff;
    text-wrap: balance;
  }
  .hook h1 {
    margin: 0 auto 16px;
    font-family: var(--font);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 24ch;
    color: rgba(255, 255, 255, 0.96);
  }
  .lede {
    margin: 0 auto 30px;
    max-width: 38ch;
    font-size: clamp(1rem, 1.7vw, 1.12rem);
    line-height: 1.55;
    color: rgba(245, 246, 248, 0.88);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 20px;
    align-items: center;
    justify-content: center;
  }
  .hook .cta-amazon {
    min-width: 10.5rem;
    padding-inline: 26px;
  }
  .hook .cta-ghost {
    color: #fff;
    border-bottom-color: rgba(255, 255, 255, 0.7);
  }
  .hook .cta-ghost:hover {
    border-bottom-color: var(--amazon);
  }

  .shop-strip {
    background: #1a1417;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .shop-strip-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    padding-block: 0;
  }
  .shop-strip a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    color: #f5f1f3;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    transition: background 180ms ease, color 180ms ease;
  }
  .shop-strip a:last-child { border-right: 0; }
  .shop-strip a:hover {
    background: rgba(255, 153, 0, 0.12);
    color: #fff;
  }
  .shop-strip em {
    font-style: normal;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(245, 241, 243, 0.55);
  }

  .meat {
    padding: 72px 20px 20px;
    animation: rise 800ms ease 100ms both;
  }
  .meat-intro,
  .coverage-intro {
    max-width: 38rem;
    margin-bottom: 28px;
  }
  .meat-intro h2,
  .coverage-intro h2,
  .reviews-head h2,
  .close-copy h2 {
    margin: 0 0 10px;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.55rem, 2.8vw, 2rem);
    letter-spacing: -0.02em;
  }
  .meat-intro p,
  .coverage-intro p,
  .reviews-head .affiliate-note,
  .close-copy p {
    margin: 0;
    color: var(--muted);
  }
  .meat-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .meat-points li {
    display: grid;
    gap: 4px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .meat-points li:last-child { border-bottom: 1px solid var(--line); }
  .meat-points strong {
    font-family: var(--font);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .meat-points span { color: var(--muted); }

  .coverage { padding: 48px 20px 12px; }
  .coverage-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  .coverage-grid li {
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: transform 200ms ease, border-color 200ms ease;
  }
  .coverage-grid li:hover {
    transform: translateY(-3px);
    border-color: #d2c4ca;
  }
  .coverage-card {
    display: block;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .coverage-grid img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
    background: #ddd;
  }
  .coverage-grid div {
    padding: 16px 16px 18px;
  }
  .coverage-grid h3 {
    margin: 0 0 6px;
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--fg);
  }
  .coverage-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .coverage-meta {
    display: inline-block;
    margin-top: 12px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--fg);
    border-bottom: 2px solid var(--accent);
  }

  .reviews-block { padding: 56px 20px 24px; }
  .reviews-head {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 22px;
  }
  .affiliate-note { max-width: 34rem; }
  .close-cta { padding: 48px 20px 28px; }
  .close-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    min-height: 280px;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .close-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .close-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 65% 70% at 50% 50%, rgba(28, 18, 24, 0.72), rgba(28, 18, 24, 0.55));
  }
  .close-copy {
    position: relative;
    z-index: 1;
    padding: 42px 28px;
    color: #fff;
    max-width: 36rem;
    margin: 0 auto;
  }
  .close-copy h2 { color: #fff; }
  .close-copy p {
    margin: 0 auto 22px;
    color: rgba(245, 246, 248, 0.86);
  }
  .close-copy .cta-row { justify-content: center; }
  .close-copy .cta-ghost {
    color: #fff;
    border-bottom-color: var(--accent);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes drift {
    from { transform: scale(1.03) translate3d(0, 0, 0); }
    to { transform: scale(1.07) translate3d(-1%, -0.5%, 0); }
  }

  @media (min-width: 860px) {
    .meat-points {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }
    .meat-points li {
      padding: 22px 20px 22px 0;
      border-top: 0;
      border-bottom: 1px solid var(--line);
      border-right: 1px solid var(--line);
    }
    .meat-points li:last-child {
      border-right: 0;
      padding-right: 0;
    }
    .coverage-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 700px) {
    .hook { min-height: 74vh; }
    .hook-copy { padding: 64px 0 72px; }
    .shop-strip-inner {
      grid-template-columns: 1fr;
    }
    .shop-strip a {
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .shop-strip a:last-child { border-bottom: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hook-copy, .meat { animation: none; }
    .hook-media .slide.is-active { animation: none; transform: none; }
  }
</style>
