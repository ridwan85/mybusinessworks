---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { categoryHubs, reviewsForHub } from '../lib/categories';

const reviews = (await getCollection('reviews')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = reviews[0];

const heroSlides = [
  '/images/site/hero-home-lifestyle.jpg',
  '/images/site/hero-workspace.jpg',
  '/images/site/hero-parcels.jpg',
];
const heroImage = heroSlides[0];

const coverage = categoryHubs.map((hub) => ({
  ...hub,
  count: reviewsForHub(reviews, hub).length,
  href: `/categories/${hub.slug}/`,
}));

const siteUrl = Astro.site ? new URL('/', Astro.site).href : 'https://mybusinesswork.com/';
const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Daily Viral Deals',
      url: siteUrl,
      description:
        'Clear Amazon product reviews for home, tech, and everyday essentials—honest verdicts, real tradeoffs, and confident buy/skip calls.',
      publisher: {
        '@type': 'Organization',
        name: 'Daily Viral Deals',
        url: siteUrl,
      },
    },
    {
      '@type': 'Organization',
      name: 'Daily Viral Deals',
      url: siteUrl,
    },
  ],
};
---

<Base
  layout="landing"
  ogType="website"
  title="Daily Viral Deals | Honest Amazon Product Picks"
  description="Clear Amazon product reviews for home, tech, and everyday essentials—honest verdicts, real tradeoffs, and confident buy/skip calls."
  image={heroImage}
>
  <section class="hook" aria-label="Hero">
    <div class="hook-media" aria-hidden="true">
      {heroSlides.map((src, i) => (
        <img class:list={['slide', i === 0 && 'is-active']} src={src} alt="" width="1600" height="900" data-slide={i} />
      ))}
      <div class="hook-shade"></div>
    </div>
    <div class="hook-copy">
      <p class="brand-mark">Daily Viral Deals</p>
      <h1>Clear reviews. Confident purchases.</h1>
      <p class="lede">
        Independent Amazon guidance for home, tech, and everyday essentials—so you know what matters before you buy.
      </p>
      <div class="cta-row">
        <a class="cta cta-amazon" href="#reviews">Shop reviews</a>
        {featured && (
          <a class="cta-ghost" href={`/reviews/${featured.id}/`}>Latest pick</a>
        )}
      </div>
    </div>
  </section>

  <nav class="shop-strip" aria-label="Shop by category">
    <div class="shop-strip-inner wrap-wide">
      {coverage.map((item) => (
        <a href={item.href}>
          <span>{item.label}</span>
          <em>{item.count > 0 ? `${item.count}` : 'Soon'}</em>
        </a>
      ))}
    </div>
  </nav>

  <section class="reviews-block wrap-wide" id="reviews" aria-labelledby="reviews-title">
    <div class="reviews-head">
      <div>
        <h2 id="reviews-title">Latest reviews</h2>
        <p class="notice affiliate-note">As an Amazon Associate I earn from qualifying purchases.</p>
      </div>
      {reviews.length > 1 && (
        <div class="carousel-controls" data-carousel-controls="reviews">
          <button type="button" class="carousel-btn" data-dir="-1" aria-label="Previous reviews">‹</button>
          <button type="button" class="carousel-btn" data-dir="1" aria-label="Next reviews">›</button>
        </div>
      )}
    </div>

    {reviews.length === 0 ? (
      <p>No reviews yet. Check back soon.</p>
    ) : (
      <div class="carousel" data-carousel="reviews">
        <ul class="carousel-track" data-carousel-track>
          {reviews.map((r) => <ReviewCard review={r} />)}
        </ul>
      </div>
    )}
  </section>

  <section class="meat wrap-wide" aria-labelledby="meat-title">
    <div class="meat-intro">
      <h2 id="meat-title">What you get in every review</h2>
      <p>Practical buying help—not hype. The same structure, every category.</p>
    </div>
    <ol class="meat-points">
      <li>
        <strong>Quick verdict first</strong>
        <span>Get the bottom line before you dig into the details.</span>
      </li>
      <li>
        <strong>Who it’s actually for</strong>
        <span>Match the product to your needs, budget, and use case.</span>
      </li>
      <li>
        <strong>Honest tradeoffs</strong>
        <span>Pros, caveats, and FAQs grounded in listed product facts—not invented lab tests.</span>
      </li>
    </ol>
  </section>

  <section class="coverage wrap-wide" id="categories" aria-labelledby="coverage-title">
    <div class="coverage-intro coverage-head">
      <div>
        <h2 id="coverage-title">Shop by category</h2>
        <p>Swipe through categories—new picks land here as the catalog grows.</p>
      </div>
      <div class="carousel-controls" data-carousel-controls="categories">
        <button type="button" class="carousel-btn" data-dir="-1" aria-label="Previous categories">‹</button>
        <button type="button" class="carousel-btn" data-dir="1" aria-label="Next categories">›</button>
      </div>
    </div>
    <div class="carousel" data-carousel="categories">
      <ul class="carousel-track coverage-track" data-carousel-track>
        {coverage.map((item) => (
          <li class="coverage-slide">
            <a class="coverage-card" href={item.href}>
              <img src={item.src} alt="" loading="lazy" width="720" height="480" />
              <div>
                <h3>{item.label}</h3>
                <p>{item.blurb}</p>
                <span class="coverage-meta">
                  {item.count > 0
                    ? `${item.count} ${item.count === 1 ? 'review' : 'reviews'} →`
                    : 'Coming soon →'}
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="close-cta wrap-wide" aria-labelledby="close-title">
    <div class="close-panel">
      <img class="close-bg" src="/images/site/hero-parcels.jpg" alt="" aria-hidden="true" />
      <div class="close-shade"></div>
      <div class="close-copy">
        <h2 id="close-title">Ready to choose with confidence?</h2>
        <p>Open a review, scan the verdict, then check today’s price on Amazon.</p>
        <div class="cta-row">
          {featured ? (
            <a class="cta" href={`/reviews/${featured.id}/`}>Open latest review</a>
          ) : (
            <a class="cta" href="#reviews">Browse reviews</a>
          )}
          <a class="cta-ghost" href="/disclosure/">How affiliate links work</a>
        </div>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />
</Base>

<script>
  const slides = [...document.querySelectorAll('.hook-media .slide')];
  if (slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    setInterval(() => {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    }, 5500);
  }

  // Horizontal carousels (reviews + categories) — swipe or use arrows
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const id = root.getAttribute('data-carousel');
    const track = root.querySelector('[data-carousel-track]');
    if (!track) return;
    const controls = document.querySelector(`[data-carousel-controls="${id}"]`);
    const step = () => {
      const card = track.querySelector(':scope > *');
      if (!card) return Math.min(280, track.clientWidth * 0.85);
      const style = getComputedStyle(track);
      const gap = parseFloat(style.columnGap || style.gap || '16') || 16;
      return card.getBoundingClientRect().width + gap;
    };
    controls?.querySelectorAll('[data-dir]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.getAttribute('data-dir') || 1);
        track.scrollBy({ left: dir * step(), behavior: 'smooth' });
      });
    });
  });
</script>

<style>
  .hook {
    position: relative;
    min-height: min(82vh, 720px);
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #f5f6f8;
    text-align: center;
  }
  .hook-media { position: absolute; inset: 0; }
  .hook-media .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 1.1s ease;
  }
  .hook-media .slide.is-active {
    opacity: 1;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .hook-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% 48%, rgba(20, 12, 16, 0.55) 0%, rgba(20, 12, 16, 0.28) 52%, rgba(20, 12, 16, 0.62) 100%),
      linear-gradient(180deg, rgba(22, 14, 18, 0.45) 0%, rgba(22, 14, 18, 0.18) 38%, rgba(22, 14, 18, 0.72) 100%);
  }
  .hook-copy {
    position: relative;
    z-index: 1;
    width: min(720px, calc(100% - (var(--page-gutter) * 2)));
    padding: 72px 0 80px;
    margin: 0 auto;
    animation: rise 700ms ease both;
  }
  .brand-mark {
    margin: 0 0 18px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.35rem, 7vw, 4.1rem);
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: #fff;
    text-wrap: balance;
  }
  .hook h1 {
    margin: 0 auto 16px;
    font-family: var(--font);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 24ch;
    color: rgba(255, 255, 255, 0.96);
  }
  .lede {
    margin: 0 auto 30px;
    max-width: 38ch;
    font-size: clamp(1rem, 1.7vw, 1.12rem);
    line-height: 1.55;
    color: rgba(245, 246, 248, 0.88);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 20px;
    align-items: center;
    justify-content: center;
  }
  .hook .cta-amazon {
    min-width: 10.5rem;
    padding-inline: 26px;
  }
  .hook .cta-ghost {
    color: #fff;
    border-bottom-color: rgba(255, 255, 255, 0.7);
  }
  .hook .cta-ghost:hover {
    border-bottom-color: var(--amazon);
  }

  .shop-strip {
    background: #1a1417;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .shop-strip-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    /* never set padding shorthand here — it would wipe .wrap-wide side gutters */
  }
  .shop-strip a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 4px;
    color: #f5f1f3;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    transition: background 180ms ease, color 180ms ease;
  }
  .shop-strip a:last-child { border-right: 0; }
  .shop-strip a:hover {
    background: rgba(255, 153, 0, 0.12);
    color: #fff;
  }
  .shop-strip em {
    font-style: normal;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(245, 241, 243, 0.55);
  }

  .meat {
    padding-top: 48px;
    padding-bottom: 12px;
    animation: rise 800ms ease 100ms both;
  }
  .meat-intro {
    max-width: 38rem;
    margin-bottom: 28px;
  }
  .coverage-intro {
    max-width: none;
    margin-bottom: 0;
    width: 100%;
  }
  .coverage-intro > div:first-child,
  .reviews-head > div:first-child {
    max-width: 34rem;
  }
  .meat-intro h2,
  .coverage-intro h2,
  .reviews-head h2,
  .close-copy h2 {
    margin: 0 0 10px;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.55rem, 2.8vw, 2rem);
    letter-spacing: -0.02em;
  }
  .meat-intro p,
  .coverage-intro p,
  .reviews-head .affiliate-note,
  .close-copy p {
    margin: 0;
    color: var(--muted);
  }
  .meat-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .meat-points li {
    display: grid;
    gap: 4px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .meat-points li:last-child { border-bottom: 1px solid var(--line); }
  .meat-points strong {
    font-family: var(--font);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .meat-points span { color: var(--muted); }

  .coverage {
    padding-top: 48px;
    padding-bottom: 12px;
  }
  .coverage-head,
  .reviews-head {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .coverage-slide {
    list-style: none;
    flex: 0 0 min(58vw, 220px);
    scroll-snap-align: start;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: transform 200ms ease, border-color 200ms ease;
  }
  .coverage-slide:hover {
    transform: translateY(-3px);
    border-color: #d2c4ca;
  }
  .coverage-card {
    display: block;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }
  .coverage-slide img {
    width: 100%;
    aspect-ratio: 16 / 8;
    max-height: 120px;
    object-fit: cover;
    display: block;
    background: #ddd;
  }
  .coverage-slide div {
    padding: 12px 14px 14px;
  }
  .coverage-slide h3 {
    margin: 0 0 6px;
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--fg);
  }
  .coverage-slide p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .coverage-meta {
    display: inline-block;
    margin-top: 12px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--fg);
    border-bottom: 2px solid var(--accent);
  }

  .reviews-block {
    padding-top: 40px;
    padding-bottom: 20px;
  }
  .affiliate-note { max-width: 34rem; margin-top: 10px; }

  .carousel {
    /* Cards may hug the screen edge; section titles stay inset via .wrap-wide */
    margin-inline: calc(var(--page-gutter) * -1);
  }
  .carousel-track {
    list-style: none;
    margin: 0;
    padding: 4px var(--page-gutter) 12px;
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-gutter);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-controls {
    display: flex;
    gap: 8px;
  }
  .carousel-btn {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fg);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
  }
  .carousel-btn:hover {
    border-color: #d2c4ca;
    background: #fff;
  }
  .close-cta {
    padding-top: 40px;
    padding-bottom: 28px;
  }
  .close-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    min-height: 280px;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .close-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .close-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 65% 70% at 50% 50%, rgba(28, 18, 24, 0.72), rgba(28, 18, 24, 0.55));
  }
  .close-copy {
    position: relative;
    z-index: 1;
    padding: 42px 28px;
    color: #fff;
    max-width: 36rem;
    margin: 0 auto;
  }
  .close-copy h2 { color: #fff; }
  .close-copy p {
    margin: 0 auto 22px;
    color: rgba(245, 246, 248, 0.86);
  }
  .close-copy .cta-row { justify-content: center; }
  .close-copy .cta-ghost {
    color: #fff;
    border-bottom-color: var(--accent);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes drift {
    from { transform: scale(1.03) translate3d(0, 0, 0); }
    to { transform: scale(1.07) translate3d(-1%, -0.5%, 0); }
  }

  @media (min-width: 860px) {
    .meat-points {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }
    .meat-points li {
      padding: 22px 20px 22px 0;
      border-top: 0;
      border-bottom: 1px solid var(--line);
      border-right: 1px solid var(--line);
    }
    .meat-points li:last-child {
      border-right: 0;
      padding-right: 0;
    }
    .coverage-slide { flex-basis: 220px; }
    .coverage-slide img { max-height: 100px; }
  }

  @media (max-width: 700px) {
    .hook { min-height: min(70vh, 640px); }
    .hook-copy {
      width: min(34rem, calc(100% - (var(--page-gutter) * 2)));
      padding: 56px 0 64px;
    }
    .brand-mark {
      font-size: clamp(1.9rem, 10vw, 2.6rem);
      margin-bottom: 14px;
    }
    .hook h1 {
      max-width: 20ch;
      font-size: 1.12rem;
    }
    .lede {
      max-width: 32ch;
      margin-bottom: 24px;
    }
    .cta-row {
      flex-direction: column;
      width: 100%;
    }
    .hook .cta-amazon,
    .hook .cta-ghost {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
    .shop-strip-inner {
      grid-template-columns: 1fr;
    }
    .shop-strip a {
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding: 14px 0;
      /* horizontal inset comes from .wrap-wide gutters */
    }
    .shop-strip a:last-child { border-bottom: 0; }
    .close-copy { padding: 32px var(--page-gutter); }
    .coverage-slide { flex-basis: min(58vw, 210px); }
    .coverage-slide img { max-height: 88px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hook-copy, .meat { animation: none; }
    .hook-media .slide.is-active { animation: none; transform: none; }
  }
</style>
