---
import { slugifyCategory } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';

interface Props {
  review: CollectionEntry<'reviews'>;
}
const { review: r } = Astro.props;
const href = `/reviews/${r.id}/`;
---

<li class="card">
  <article class="card-inner">
    <a class="media" href={href} tabindex="-1" aria-hidden="true">
      {r.data.imageSrc ? (
        <img src={r.data.imageSrc} alt="" loading="lazy" />
      ) : (
        <div class="media-fallback"></div>
      )}
    </a>
    <div class="body">
      {r.data.category && (
        <p class="eyebrow">
          <a href={`/categories/${slugifyCategory(r.data.category)}/`}>{r.data.category}</a>
        </p>
      )}
      <h3><a href={href}>{r.data.title}</a></h3>
      <p>{r.data.description}</p>
      <a class="read-link" href={href}>Read review</a>
    </div>
  </article>
</li>

<style>
  .card {
    list-style: none;
    height: 100%;
    scroll-snap-align: start;
    flex: 0 0 min(78vw, 280px);
  }
  .card-inner { display: flex; flex-direction: column; height: 100%; }
  .media { display: block; }
  .media img, .media-fallback {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #fff;
    display: block;
  }
  .body {
    padding: 14px 16px 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .eyebrow {
    margin: 0 0 6px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .eyebrow a {
    color: var(--muted);
    text-decoration: none;
  }
  .eyebrow a:hover { color: var(--fg); text-decoration: underline; }
  h3 {
    margin: 0 0 6px;
    font-size: 1.05rem;
    line-height: 1.35;
    font-weight: 600;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a:hover { text-decoration: underline; }
  .body > p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .read-link {
    display: inline-block;
    margin-top: auto;
    padding-top: 12px;
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    align-self: flex-start;
  }

  @media (min-width: 860px) {
    .card { flex-basis: 260px; }
  }
</style>
